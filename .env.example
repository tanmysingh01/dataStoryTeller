# Microsoft Fabric Authentication Configuration

# Azure AD / Service Principal Authentication
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# User Authentication (alternative to Service Principal)
FABRIC_USERNAME=your_username@example.com
FABRIC_PASSWORD=your_password_here

# Fabric Workspace Configuration
FABRIC_WORKSPACE_NAME=MyFabricWorkspace
FABRIC_WORKSPACE_ID=workspace_id_from_fabric_portal
FABRIC_CAPACITY_ID=your_capacity_id_here

# API Endpoints (usually don't need to change)
FABRIC_API_URL=https://api.fabric.microsoft.com
POWER_BI_API_URL=https://api.powerbi.com/v1.0/myorg

# Authentication Method
# Options: 'service_principal' or 'user'
AUTH_METHOD=service_principal

# Logging Level
# Options: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO
